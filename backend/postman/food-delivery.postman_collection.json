        {
          "name": "Filter by cuisine + city",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restaurants?cuisine=north%20indian&city=pune",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Restaurant details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Menu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
            "auth": {
              "type": "noauth"
