                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  try { const v = json.categories[0].items[0].id; if (v !== undefined) pm.collectionVariables.set('itemId', v); } catch (e) {}",
                  "  try { const v = json.categories[0].items[1].id; if (v !== undefined) pm.collectionVariables.set('itemId2', v); } catch (e) {}",
                  "}"
