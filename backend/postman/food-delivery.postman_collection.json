              }
            ],
            "url": "{{baseUrl}}/users/me/addresses",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Office\",\n  \"line1\": \"5th Floor, Tech Park\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411014\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Browse restaurants (public)",
      "item": [
        {
          "name": "List restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restaurants",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  try { const v = json.items[0].id; if (v !== undefined) pm.collectionVariables.set('restaurantId', v); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restaurants?search=dosa",
