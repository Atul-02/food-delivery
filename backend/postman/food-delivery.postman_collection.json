                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  try { const v = json[0].id; if (v !== undefined) pm.collectionVariables.set('addressId', v); } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Add address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
