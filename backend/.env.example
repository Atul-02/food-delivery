NODE_ENV=development
PORT=4000

# Neon gives two URLs. Pooled (host has "-pooler") is used by the app,
# direct is used by migrations. For a local Postgres, use the same URL for both.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Use a long random string (at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Flat delivery fee in paise (4000 = Rs 40)
DELIVERY_FEE_PAISE=4000

# Used by the seed script to create the first admin
SEED_ADMIN_EMAIL=admin@fooddelivery.local
SEED_ADMIN_PASSWORD=Admin@12345
